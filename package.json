{
  "name": "jamovi-docs",
  "version": "1.0.0",
  "description": "jamovi documentation using Sphinx. The documentation is available at https://jamovi.readthedocs.org (and translations can be chosen by clicking at the menu that unfolds after pressing at «Read the Docs» at the bottom). Whoever would like to contribute with translations, please read a little [further down](#translate).",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run generate-translations && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "convert": "bash scripts/convert-rst.sh && python3 scripts/postprocess-mdx.py",
    "convert:rst": "bash scripts/convert-rst.sh",
    "convert:post": "python3 scripts/postprocess-mdx.py",
    "generate-translations": "git submodule update --init _locale && python3 scripts/generate-translations.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raviselker/jamovi-docs.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/raviselker/jamovi-docs/issues"
  },
  "homepage": "https://github.com/raviselker/jamovi-docs#readme",
  "dependencies": {
    "@astrojs/starlight": "^0.39.2",
    "astro": "^6.3.8"
  }
}
