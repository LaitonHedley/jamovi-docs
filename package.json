{
  "name": "jamovi-docs",
  "version": "1.0.0",
  "description": "Documentation for jamovi, available at https://docs.jamovi.org",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run generate-translations && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "convert": "bash scripts/convert-rst.sh && python3 scripts/postprocess-mdx.py",
    "convert:rst": "bash scripts/convert-rst.sh",
    "convert:post": "python3 scripts/postprocess-mdx.py",
    "generate-translations": "git submodule update --init _locale && python3 scripts/generate-translations.py",
    "convert:gifs": "bash scripts/convert-gifs.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamovi/jamovi-docs.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jamovi/jamovi-docs/issues"
  },
  "homepage": "https://github.com/jamovi/jamovi-docs#readme",
  "dependencies": {
    "@astrojs/starlight": "^0.39.2",
    "astro": "^6.3.8"
  }
}
